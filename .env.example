# RM Tiling — environment variables
# Copy to `.env.local` for local development, or set these in your host
# (e.g. Vercel project settings) for production. All are OPTIONAL: the contact
# form works without them, logging submissions to the server console.

# --- Contact form delivery (choose ONE) -----------------------------------

# Option A: POST each enquiry as JSON to any webhook
# (Zapier, Make, a Slack/Discord incoming webhook, your own endpoint, ...)
# CONTACT_WEBHOOK_URL=

# Option B: Send enquiries by email via Resend (https://resend.com)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@rmtiling.com.au
# CONTACT_FROM_EMAIL="RM Tiling <quotes@yourdomain.com>"
